---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import pages from '../../data/pages.json';
const copy = pages.projects;
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
---
<SiteLayout title={project.data.title} description={project.data.summary}>
  <section class="page-hero container">
    <a class="back-link" href={`${base}projects/`}>← {copy.backLink}</a>
    <p class="eyebrow">{[project.data.location, project.data.year].filter(Boolean).join(' · ')}</p>
    <h1>{project.data.title}</h1>
    <p class="project-summary">{project.data.summary}</p>
  </section>
  <article class="project-detail container">
    <div class="prose"><Content /></div>
    {project.data.gallery.length ? <div class="project-gallery">{project.data.gallery.map((item) => <img src={`${base}${item.image.replace(/^\//, '')}`} alt={item.alt} />)}</div> : <div class="image-placeholder detail-placeholder">{copy.detailImagePlaceholder}</div>}
  </article>
</SiteLayout>

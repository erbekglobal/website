    <!-- JAVASCRIPT ETKİLEŞİMLERİ -->
    <script is:inline>
        // Yıl bilgisini otomatik güncelle
        document.getElementById('current-year').textContent = new Date().getFullYear();

        // 1. Mobil Menü Açma / Kapatma
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');

        mobileMenuBtn.addEventListener('click', () => {
            const isHidden = mobileMenu.classList.contains('hidden');
            if (isHidden) {
                mobileMenu.classList.remove('hidden');
                menuIcon.classList.remove('fa-bars');
                menuIcon.classList.add('fa-xmark');
            } else {
                mobileMenu.classList.add('hidden');
                menuIcon.classList.remove('fa-xmark');
                menuIcon.classList.add('fa-bars');
            }
        });

        // Mobil linke tıklanınca menüyü kapat
        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                menuIcon.classList.remove('fa-xmark');
                menuIcon.classList.add('fa-bars');
            });
        });

        // 2. Proje Verileri ve Modal Yönetimi
        const projectsData = [
            {
                title: "Çorlu Prestige Apartmanı",
                status: "Tamamlandı ve Teslim Edildi",
                location: "Tekirdağ / Çorlu",
                type: "Kentsel Dönüşüm Projesi",
                image: "/uploads/corlu-prestige-apt.jpg",
                description: "Çorlu'da güncel deprem yönetmeliğine uygun, modern dış cephe mimarisi, kaliteli iç mekan donatıları ve yüksek yapı güvenliğiyle tüm bağımsız bölümleri tamamlanmış, satışı gerçekleşmiş ve hak sahiplerine eksiksiz teslim edilmiştir.",
                features: [
                    "C35/45 Yüksek Dayanımlı Beton Sınıfı",
                    "Radye Temel & TBDY 2018 Deprem Uyumu",
                    "Isı ve Ses Yalıtımlı Dış Cephe Sistemi",
                    "Tamamlandı, Teslim Edildi & Hepsi Satıldı"
                ]
            },
            {
                title: "Ergene Prestige Konutları",
                status: "Tamamlandı ve Teslim Edildi",
                location: "Tekirdağ / Ergene",
                type: "Modern Konut & Yaşam Alanı",
                image: "/uploads/ergene-prestige-apt.jpg",
                description: "Ergene'nin hızla değer kazanan aksında; ferah kat planları ve yüksek ısı-ses yalıtımlı cephe sistemleriyle inşaatı tamamlanmış, tüm daireleri satılmış ve sahiplerine teslim edilmiştir.",
                features: [
                    "Deprem Yönetmeliğine %100 Tam Uyum",
                    "Birinci Sınıf Malzeme ve İşçilik",
                    "Merkezi Isıtma & Modern Tesisat Altyapısı",
                    "Tamamlandı, Teslim Edildi & Hepsi Satıldı"
                ]
            },
            {
                title: "Esenyurt Prestige Rezidans",
                status: "Tamamlandı ve Teslim Edildi",
                location: "İstanbul / Esenyurt",
                type: "Anahtar Teslim Taahhüt",
                image: "/uploads/esenyurt-1-prestige-apt.jpg",
                description: "İstanbul Esenyurt'ta kaba yapıdan ince işçiliğe kadar A sınıfı malzeme seçimi ve titiz şantiye denetimiyle anahtar teslim olarak tamamlanmış, tüm ünitelerin satışı ve teslimatı başarıyla sonuçlandırılmıştır.",
                features: [
                    "Kapsamlı Zemin Etüdü ve Statik Çözümler",
                    "A Sınıfı Dış Cephe & Isı Yalıtım Sistemleri",
                    "Konforlu ve Fonksiyonel Daire Planları",
                    "Tamamlandı, Teslim Edildi & Hepsi Satıldı"
                ]
            }
        ];

        function openProjectModal(index) {
            const project = projectsData[index];
            if (!project) return;

            document.getElementById('modal-img').src = project.image;
            document.getElementById('modal-status').textContent = project.status;
            document.getElementById('modal-title').textContent = project.title;
            document.getElementById('modal-location').textContent = project.location;
            document.getElementById('modal-type').textContent = project.type;
            document.getElementById('modal-desc').textContent = project.description;

            const featuresList = document.getElementById('modal-features');
            featuresList.innerHTML = '';
            project.features.forEach(feat => {
                const li = document.createElement('li');
                li.className = 'flex items-center gap-2';
                li.innerHTML = `<i class="fa-solid fa-circle-check text-brand-gold text-xs shrink-0"></i><span>${feat}</span>`;
                featuresList.appendChild(li);
            });

            const modal = document.getElementById('project-modal');
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeProjectModal() {
            const modal = document.getElementById('project-modal');
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }

        function closeModalOnBackdrop(event) {
            if (event.target.id === 'project-modal') {
                closeProjectModal();
            }
        }

        // ESC tuşu ile modal kapatma
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeProjectModal();
                closeLightbox();
            }
        });

        // Lightbox fonksiyonları
        function openLightbox(src, alt) {
            document.getElementById('lightbox-img').src = src;
            document.getElementById('lightbox-img').alt = alt || '';
            document.getElementById('lightbox-caption').textContent = alt || '';
            document.getElementById('lightbox').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            document.getElementById('lightbox').classList.add('hidden');
            document.getElementById('lightbox-img').src = '';
            document.body.style.overflow = '';
        }

        // 3. Proje Filtreleme
        function filterProjects(category) {
            // Buton aktiflik stillerini güncelle
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.dataset.filter === category) {
                    btn.classList.add('bg-brand-dark', 'text-white', 'shadow-sm');
                    btn.classList.remove('text-slate-600');
                } else {
                    btn.classList.remove('bg-brand-dark', 'text-white', 'shadow-sm');
                    btn.classList.add('text-slate-600');
                }
            });

            // Kartları göster/gizle
            document.querySelectorAll('.project-card').forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        // 4. Hizmet Kartından Form Seçimi Yapma
        function selectService(serviceName) {
            const selectEl = document.getElementById('serviceType');
            if (selectEl) {
                selectEl.value = serviceName;
            }
        }

        // 5. Ön Değerlendirme Formu Gönderimi & WhatsApp Entegrasyonu
        function buildWhatsAppUrlFromForm() {
            const name = document.getElementById('fullName').value.trim() || 'Belirtilmedi';
            const phone = document.getElementById('phone').value.trim() || 'Belirtilmedi';
            const service = document.getElementById('serviceType').value;
            const location = document.getElementById('location').value.trim() || 'Belirtilmedi';
            const notes = document.getElementById('notes').value.trim();

            let message = `Merhaba ERBEK GLOBAL INNOVATION,\nWeb siteniz üzerinden ön değerlendirme talebi oluşturuyorum:\n\n`;
            message += `• Ad Soyad: ${name}\n`;
            message += `• Telefon: ${phone}\n`;
            message += `• Hizmet Türü: ${service}\n`;
            message += `• Konum / İlçe: ${location}\n`;
            if (notes) {
                message += `• Not: ${notes}\n`;
            }

            return `https://wa.me/905546007979?text=${encodeURIComponent(message)}`;
        }

        function handleFormSubmit(event) {
            event.preventDefault();
            const name = document.getElementById('fullName').value.trim();
            const service = document.getElementById('serviceType').value;
            const location = document.getElementById('location').value.trim();

            const waUrl = buildWhatsAppUrlFromForm();
            document.getElementById('whatsapp-send-link').href = waUrl;
            document.getElementById('feedback-summary').textContent = 
                `Sayın ${name}, "${location}" konumundaki "${service}" talebiniz kayıt altına alındı. Hızlı dönüş için aşağıdaki butondan bilgilerinizi doğrudan WhatsApp hattımıza da aktarabilirsiniz.`;

            document.getElementById('form-feedback').classList.remove('hidden');
            document.getElementById('evaluation-form').classList.add('hidden');
        }

        function sendDirectWhatsAppFromForm() {
            const waUrl = buildWhatsAppUrlFromForm();
            window.open(waUrl, '_blank', 'noopener,noreferrer');
        }

        function resetEvaluationForm() {
            document.getElementById('evaluation-form').reset();
            document.getElementById('form-feedback').classList.add('hidden');
            document.getElementById('evaluation-form').classList.remove('hidden');
        }
    </script>

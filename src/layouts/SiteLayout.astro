---
import company from '../data/company.json';
import '../styles/global.css';
const { title = company.name, description = company.slogan } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(base, '/');
const links = [
  { label: 'Ana Sayfa', href: base },
  { label: 'Projeler', href: `${base}projects/` },
  { label: 'Hakkımızda', href: `${base}about/` },
  { label: 'İletişim', href: `${base}contact/` },
];
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#03182b" />
    <title>{title} | {company.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base} aria-label={`${company.name} ana sayfa`}>
          <span class="brand-name">{company.name}</span>
          <span class="brand-sector">{company.sector}</span>
        </a>
        <nav aria-label="Ana menü">
          {links.map((link) => <a href={link.href} aria-current={currentPath === link.href.replace(base, '/') ? 'page' : undefined}>{link.label}</a>)}
        </nav>
        <a class="header-phone" href={`tel:${company.phone}`}>{company.phoneDisplay}</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand" href={base}>
          <span class="brand-name">{company.name}</span>
          <span class="brand-sector">{company.sector}</span>
        </a>
        <p>{company.slogan}</p>
        <a class="text-link" href={`${base}admin/`}>Yönetim</a>
        <a href={`tel:${company.phone}`}>{company.phoneDisplay}</a>
      </div>
    </footer>
  </body>
</html>

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>ERBEK GLOBAL INNOVATION içerik yönetimi</title>
  </head>
  <body>
    <p id="setup-note" hidden>Yayın ortamında giriş için GitHub OAuth sunucusu yapılandırılmalıdır. Ayrıntılar README dosyasındadır.</p>
    <script is:inline src="https://unpkg.com/decap-cms@3.16.3/dist/decap-cms.js"></script>
    <script is:inline>
      if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
        document.getElementById('setup-note').hidden = false;
      }
    </script>
  </body>
</html>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactCallout from '../components/ContactCallout.astro';
import company from '../data/company.json';
import pages from '../data/pages.json';
const base = import.meta.env.BASE_URL;
const services = company.services;
const copy = pages.home;
---
<SiteLayout title={copy.seoTitle}>
  <section class="hero">
    <div class="container hero-content">
      <p class="eyebrow">{company.sector}</p>
      <h1>{company.slogan}</h1>
      <p class="hero-copy"><span>{company.intro}</span><span>{company.contactPrompt}</span></p>
      <a class="button button-gold" href={`${base}contact/`}>{copy.contactButton}</a>
    </div>
  </section>
  <section class="section container services-layout">
    <div class="section-heading">
      <p class="eyebrow">{company.name}</p>
      <h2>{copy.servicesHeading}</h2>
      <p>{copy.servicesIntro}</p>
    </div>
    <ul class="service-grid">
      {services.map((service, i) => <li><span class="service-index">0{i + 1}</span><h3>{service}</h3></li>)}
    </ul>
  </section>
  <section class="project-invite container">
    <div><p class="eyebrow">{company.name}</p><h2>{copy.projectsHeading}</h2></div>
    <a class="text-link" href={`${base}projects/`}>{copy.projectsLink}</a>
  </section>
  <ContactCallout />
</SiteLayout>

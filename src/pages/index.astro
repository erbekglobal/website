---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactCallout from '../components/ContactCallout.astro';
import company from '../data/company.json';
const base = import.meta.env.BASE_URL;
const services = company.services;
---
<SiteLayout title="İnşaat Taahhüt">
  <section class="hero">
    <div class="container hero-content">
      <p class="eyebrow">{company.sector}</p>
      <h1>{company.slogan}</h1>
      <p class="hero-copy">{company.intro}. {company.contactPrompt}</p>
      <a class="button button-gold" href={`${base}contact/`}>İletişime geçin <span aria-hidden="true">→</span></a>
      <div class="hero-rule" aria-hidden="true"><span></span></div>
    </div>
    <div class="hero-mark" aria-hidden="true">EG</div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <p class="eyebrow">{company.name}</p>
      <h2>Hizmet alanlarımız</h2>
      <p>İhtiyacınızı paylaşın, projenizi birlikte değerlendirelim.</p>
    </div>
    <ul class="service-grid">
      {services.map((service, i) => <li><span class="service-index">0{i + 1}</span><h3>{service}</h3><span class="service-arrow" aria-hidden="true">↗</span></li>)}
    </ul>
  </section>
  <section class="project-invite container">
    <div><p class="eyebrow">{company.name}</p><h2>Projelerimizi keşfedin</h2></div>
    <a class="text-link" href={`${base}projects/`}>Projeleri görüntüle <span aria-hidden="true">→</span></a>
  </section>
  <ContactCallout />
</SiteLayout>

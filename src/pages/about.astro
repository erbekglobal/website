---
import SiteLayout from '../layouts/SiteLayout.astro';
import company from '../data/company.json';
import pages from '../data/pages.json';
const copy = pages.about;
const sections = copy.sections ?? [];
---
<SiteLayout title={copy.seoTitle}>
  <section class="page-hero container"><p class="eyebrow">{company.name}</p><h1>{copy.pageHeading}</h1></section>
  <article class="section container about-content">
    {sections.map((section, index) => <section>
      <h2>{section.heading}</h2>
      {(section.paragraphs ?? []).map((paragraph) => <p>{paragraph}</p>)}
      {section.lead && <p>{section.lead}</p>}
      {!!section.bullets?.length && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
      {section.closing && <p>{section.closing}</p>}
      {index === sections.length - 1 && <p class="about-signature"><strong>{company.name} {copy.signatureSuffix}</strong><br />{copy.signatureTagline}</p>}
    </section>)}
  </article>
  <section class="section container about-services">
    <div><p class="eyebrow">{company.sector}</p><h2>{company.slogan}</h2></div>
    <ul class="plain-list">{company.services.map((service) => <li>{service}</li>)}</ul>
  </section>
</SiteLayout>

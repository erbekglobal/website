---
import company from '../data/company.json';
import pages from '../data/pages.json';
import '../styles/global.css';
const { title = company.name, description = company.slogan } = Astro.props;
const base = import.meta.env.BASE_URL;
const hasInnovation = company.name.endsWith(' INNOVATION');
const brandName = hasInnovation ? company.name.slice(0, -11) : company.name;
const currentPath = Astro.url.pathname.replace(base, '/');
const links = [
  { label: company.navigation.home, href: base },
  { label: company.navigation.projects, href: `${base}projects/` },
  { label: company.navigation.about, href: `${base}about/` },
  { label: company.navigation.contact, href: `${base}contact/` },
];
const contactCopy = pages.contact;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <title>{title} | {company.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{company.shared.skipLink}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base} aria-label={`${company.name} ${company.shared.brandHomeLabel}`}>
          <span class="brand-name">{brandName}</span>
          {hasInnovation && <span class="brand-innovation">INNOVATION</span>}
          <span class="brand-sector">{company.sector}</span>
        </a>
        <nav aria-label={company.shared.navigationLabel}>
          {links.map((link) => <a href={link.href} aria-current={currentPath === link.href.replace(base, '/') ? 'page' : undefined}>{link.label}</a>)}
        </nav>
        <a class="header-phone" href={`tel:${company.phone}`}>{company.phoneDisplay}</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand" href={base}>
          <span class="brand-name">{brandName}</span>
          {hasInnovation && <span class="brand-innovation">INNOVATION</span>}
          <span class="brand-sector">{company.sector}</span>
        </a>
        <div class="footer-message">
          <p class="eyebrow">{company.intro}</p>
          <h2>{company.contactPrompt}</h2>
        </div>
        <div class="callout-actions">
          <a class="button button-gold" href={`tel:${company.phone}`} aria-label={`${company.shared.calloutPhoneLabel}: ${company.phoneDisplay}`}>{company.phoneDisplay}</a>
          <a class="text-link" href={company.whatsapp} target="_blank" rel="noopener noreferrer">{contactCopy.whatsappButton}</a>
          <a class="text-link" href={`${base}contact/`}>{company.shared.calloutContactLabel} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </footer>
  </body>
</html>
